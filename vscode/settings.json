// Configurações de USUÁRIO do VS Code (valem para todos os projetos).
// Destino no Windows: %APPDATA%\Code\User\settings.json
// O script scripts/setup-windows.ps1 faz backup do arquivo atual e copia este.
//
// Configurações específicas de um projeto (intérprete, debug, Tailwind etc.)
// ficam em templates/*/.vscode/ e são copiadas pelo scripts/new-project.ps1.
{
  // ───────────────────────────── Editor ─────────────────────────────
  "editor.fontFamily": "'Cascadia Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.rulers": [88, 120],
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "trailing",
  "editor.guides.bracketPairs": "active",
  "editor.linkedEditing": true, // renomeia a tag de fechamento junto com a de abertura (HTML/JSX)
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.formatOnSave": true,

  // ───────────────────────────── Arquivos ─────────────────────────────
  // LF em vez de CRLF: evita diffs "fantasma" no Git e scripts quebrados em Linux/WSL/Docker.
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true,
    "**/*.lock": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true
  },

  // ───────────────────────────── Explorer / Abas ─────────────────────────────
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, pnpm-lock.yaml, pnpm-workspace.yaml, yarn.lock, bun.lock, bun.lockb, .npmrc, .nvmrc, .node-version",
    "pyproject.toml": "uv.lock, poetry.lock, .python-version, requirements*.txt, setup.cfg, setup.py, MANIFEST.in",
    "tsconfig.json": "tsconfig.*.json, next-env.d.ts",
    "next.config.*": "postcss.config.*, tailwind.config.*, eslint.config.*, .prettierrc*, .prettierignore",
    "vite.config.*": "postcss.config.*, tailwind.config.*, eslint.config.*, .prettierrc*, .prettierignore, index.html",
    ".env": ".env.*",
    "README.md": "LICENSE*, CHANGELOG*, CONTRIBUTING*, CODE_OF_CONDUCT*",
    "Dockerfile": "docker-compose*.yml, compose*.yml, .dockerignore"
  },
  // Next.js e Django têm muitos arquivos com o mesmo nome (page.tsx, views.py...).
  // Isto mostra a pasta na aba, ex.: "dashboard/page.tsx" em vez de só "page.tsx".
  "workbench.editor.customLabels.patterns": {
    "**/app/**/page.{tsx,jsx,ts,js}": "${dirname}/page",
    "**/app/**/layout.{tsx,jsx,ts,js}": "${dirname}/layout",
    "**/app/**/route.{ts,js}": "${dirname}/route",
    "**/index.{tsx,jsx,ts,js}": "${dirname}/index",
    "**/__init__.py": "${dirname}/__init__",
    "**/{models,views,urls,admin,apps,forms,serializers,tests}.py": "${dirname}/${filename}"
  },
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "always",

  // ───────────────────────────── Terminal ─────────────────────────────
  // "PowerShell" usa o PowerShell 7 (pwsh) quando instalado. Troque por "Git Bash" se preferir.
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.smoothScrolling": true,

  // ───────────────────────────── Git ─────────────────────────────
  "git.autofetch": true,
  "git.pruneOnFetch": true,
  "git.confirmSync": false,
  "diffEditor.ignoreTrimWhitespace": false,

  // ───────────────────────────── Python ─────────────────────────────
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "[python]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "notebook.formatOnSave.enabled": true,

  // ───────────────────── Web: HTML / CSS / JS / TS / React ─────────────────────
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[html][css][scss][less][json][jsonc][yaml][markdown]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false // dois espaços no fim = quebra de linha no Markdown
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "django-html": "html",
    "jinja-html": "html"
  },

  // ───────────────────────────── Extensões ─────────────────────────────
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "cSpell.language": "en,pt-BR",
  "cSpell.enabledFileTypes": {
    "*": false,
    "markdown": true,
    "plaintext": true,
    "git-commit": true
  },
  "redhat.telemetry.enabled": false,
  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "XXX", "NOTE"]
}
