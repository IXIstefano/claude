// Dev Container: o projeto roda dentro de um container Linux com Python + Node,
// sem instalar nada no Windows. Requer Docker Desktop e a extensão Dev Containers.
// Abrir: Ctrl+Shift+P > "Dev Containers: Reopen in Container".
// Outras stacks (Go, Java, PHP, Rust...): troque a imagem ou adicione "features":
// https://containers.dev/features
{
  "name": "meu-projeto",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "pipx install uv && if [ -f pyproject.toml ]; then uv sync; fi && if [ -f package.json ]; then npm install; fi",
  // 8000: Django/FastAPI  5000: Flask  3000: Next.js  5173: Vite
  "forwardPorts": [8000, 5000, 3000, 5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "editorconfig.editorconfig",
        "anthropic.claude-code"
      ]
    }
  }
}
