// Tarefas: Ctrl+Shift+P > "Tasks: Run Task". Testes também em Ctrl+Shift+P > "Tasks: Run Test Task".
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv sync (instalar dependências)",
      "type": "shell",
      "command": "uv sync",
      "problemMatcher": []
    },
    {
      "label": "ruff: verificar",
      "type": "shell",
      "command": "uv run ruff check .",
      "problemMatcher": []
    },
    {
      "label": "ruff: corrigir e formatar",
      "type": "shell",
      "command": "uv run ruff check --fix . ; uv run ruff format .",
      "problemMatcher": []
    },
    {
      "label": "pytest",
      "type": "shell",
      "command": "uv run pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
